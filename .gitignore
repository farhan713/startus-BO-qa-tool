# Local environment
.env
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Test artifacts (these are generated, not source)
reports/*
!reports/.gitkeep
.pytest_cache/

# Process state
.pids/

# Per-user runtime data (the saved-test-cases library + directory) — generated,
# not source. Only screens_catalog.json is the durable, shared Knowledge Base.
knowledge_base/scenarios.json
knowledge_base/directory.json
knowledge_base/users.json
knowledge_base/.session_secret

# Local dev tooling (machine-specific launch config)
.claude/

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# But DO commit:
# - knowledge_base/screens_catalog.json (the durable Knowledge Base)
# - All framework/ code
# - All web_ui/ code
# - docs/ and *.md files
