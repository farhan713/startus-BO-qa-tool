# ============================================================================
# Stratus BackOffice - QA Automation Environment Config
# Copy this file to ".env" and fill in your environment values.
# ============================================================================

# --- Application under test ---
APP_BASE_URL=http://localhost:8080/backoffice
APP_LOGIN_PATH=/login.jsp
APP_AUTH_SERVLET=/UserAuthenticationServlet.do
APP_DISPATCHER=/stratus
APP_NAME=WRMS

# --- Test credentials (use a dedicated automation user, never a real admin) ---
TEST_USER=qa_automation
TEST_PASSWORD=changeme
TEST_INVALID_USER=does_not_exist
TEST_INVALID_PASSWORD=wrong_password

# --- Browser settings ---
BROWSER=chromium
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
SLOW_MO_MS=0
VIDEO_ON_FAILURE=true
SCREENSHOT_ON_FAILURE=true

# --- SQL Server connection ---
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=stratus
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_TRUST_SERVER_CERT=yes
DB_ENCRYPT=no

# --- Reporting ---
ENV_NAME=DEV
RUN_ID=local
